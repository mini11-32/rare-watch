{
  "_説明": "query は検索する言葉。include のどれかがタイトルに入っている記事だけ残す。exclude のどれかが入っている記事は捨てる。",

  "excludeAll": [
    "買取", "相場", "高騰", "値段推移", "転売", "フリマ", "メルカリ", "ヤフオク",
    "偽造", "査定", "ランキング", "引いてきた", "開封", "スウォッチ", "ネタバレ",
    "画像ページ", "調査", "集計", "当選率", "の声", "苦悩", "%"
  ],

  "keywords": [
    {
      "label": "ポケモンカード",
      "query": "(ポケモンカード OR ポケカ) 抽選",
      "_require説明": "require は [ ] のまとまりごとに、どれか1つが入っていないといけない（抽選 と BOX系 の両方が必要）",
      "require": [["抽選"], ["BOX", "Box", "box", "ボックス", "パック"]],
      "exclude": ["販売禁止", "シェア", "落選", "割が", "収録", "当たりカード", "初心者", "回し方", "スニダン", "ポケポケ"]
    },
    {
      "label": "一番くじ",
      "query": "一番くじ",
      "include": ["発売", "新作", "登場", "ラインナップ", "再販", "予約", "決定"],
      "exclude": ["反響", "歓喜", "破産", "取扱コンビニ", "最新一覧"]
    },
    {
      "label": "クリスマスコフレ",
      "query": "クリスマスコフレ 2026",
      "include": ["発売", "予約", "登場", "限定", "速報", "公開"],
      "exclude": ["おすすめ", "選】", "選！", "選【"]
    },
    {
      "label": "大型コラボ",
      "query": "コラボ (争奪戦 OR 即完売 OR 抽選販売 OR 購入制限 OR 行列)",
      "_説明": "「コラボ」と「人気が集中していることを表す言葉」の両方が入っている記事だけ残す",
      "require": [
        ["コラボ", "×", " x ", " X "],
        ["争奪戦", "即完", "完売必至", "抽選", "購入制限", "入手困難"]
      ],
      "exclude": ["御朱印", "見せてください", "選】", "選！", "選【"]
    }
  ]
}
